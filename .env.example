# ─── FRONTEND (Vite / TanStack Start) ────────────────────────────────────────
# These are inlined at build time. Prefix with VITE_ to expose to the browser.

# (No additional frontend env vars required — Google Client ID is fetched from
#  the backend /api/v1/auth/google/config at runtime.)

# ─── BACKEND (Express / Prisma) ───────────────────────────────────────────────
# Copy this section into backend/.env and fill in real values before running the
# backend. The backend reads its own .env file via dotenv.

# NODE_ENV=development
# PORT=4000

# PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ums_dev?schema=public

# JWT secrets — must be at least 32 characters each, keep secret!
# JWT_SECRET=replace-with-at-least-32-char-access-secret
# JWT_REFRESH_SECRET=replace-with-at-least-32-char-refresh-secret

# Google OAuth (Web application client from Google Cloud Console)
# GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Restrict sign-in to this Google Workspace domain (e.g. mitwpu.edu.in)
# GOOGLE_HOSTED_DOMAIN=mitwpu.edu.in

# PRN (student ID) validation
# PRN_PATTERN=^[A-Za-z0-9][A-Za-z0-9/-]{5,23}$
# PRN_FORMAT_HINT=Enter the PRN issued by MIT-WPU.

# Redis (used for rate limiting and caching)
# REDIS_URL=redis://localhost:6379

# Cloudinary (for equipment image uploads)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Frontend origin (for CORS allow-list)
# FRONTEND_URL=http://localhost:5174

# Seed script — email of the initial super-admin and faculty mentor
# SEED_SUPER_ADMIN_EMAIL=admin@mitwpu.edu.in
# SEED_FACULTY_MENTOR_EMAIL=mentor@mitwpu.edu.in
# SEED_FACULTY_MENTOR_NAME=Faculty Name
