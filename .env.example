# ─── Front end ───────────────────────────────────────────────────────────────
# These are read at BUILD time and inlined into the bundle. Changing one needs a
# rebuild, not a restart. Only VITE_-prefixed names reach the browser.

# Where the API lives.
#
# Leave blank for local development: Vite proxies /api to the Express server on
# port 4000, so the browser sees a single origin.
#
# In production set it to the API's public origin WITHOUT a trailing path —
# "/api/v1" is appended by the client. For example:
#   VITE_API_BASE_URL=https://srijan-api.onrender.com
VITE_API_BASE_URL=

# Note: the Google client ID is NOT configured here. The browser fetches it from
# the API at /auth/google/config, so it is set once on the backend
# (GOOGLE_CLIENT_ID) and both halves stay in step. The origin the app is served
# from must still be registered in the Google Cloud console as an Authorised
# JavaScript origin, or sign-in fails with no visible error.

# ─── Landing hero film (optional) ────────────────────────────────────────────
# Unset, the 2.4MB file is served from this origin but fetched only after the
# page is interactive. Point these at a CDN to take the bytes off your origin.
VITE_HERO_VIDEO_URL=
VITE_HERO_POSTER_URL=
