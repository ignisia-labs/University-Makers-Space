NODE_ENV=development
PORT=4000
# PostgreSQL. Managed providers (Neon, Supabase, Render, Railway) require TLS —
# append ?sslmode=require. Add &connection_limit=5 on small plans so one
# instance cannot exhaust the database's connection allowance.
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require&connection_limit=5
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ums_dev?schema=public
JWT_SECRET=replace-with-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-char-refresh-secret
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_HOSTED_DOMAIN=mitwpu.edu.in
PRN_PATTERN=^[A-Za-z0-9][A-Za-z0-9/-]{5,23}$
PRN_FORMAT_HINT=Enter the PRN issued by MIT-WPU.
# Redis. Managed providers speak TLS on rediss:// — ioredis picks that up from
# the scheme, so no extra configuration is needed.
#   REDIS_URL=rediss://default:pass@host:6379
REDIS_URL=redis://localhost:6379
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=demo-key
CLOUDINARY_API_SECRET=demo-secret
# Where the app is served from. Comma-separated to allow more than one origin —
# useful for a production URL alongside deploy previews. The first entry is the
# canonical one used in emails and links back to the app.
#   FRONTEND_URL=https://srijan.netlify.app
FRONTEND_URL=http://127.0.0.1:5174

# Set to true when the app and this API are on DIFFERENT hosts, which is the
# case for a Netlify front end and a Render API. It switches the session cookies
# to SameSite=None; Secure — without it the browser silently refuses to send
# them back and every sign-in is forgotten on the next request.
# Requires HTTPS, so leave it false for local development.
CROSS_SITE_COOKIES=false
# Optional. Defaults to ignisia@mitwpu.edu.in — the only identity the seed
# creates, and only as a provisioning grant, never as an account.
SEED_SUPER_ADMIN_EMAIL=ignisia@mitwpu.edu.in
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MIT-WPU MakerSpace <no-reply@mitwpu.edu.in>
MAIL_MAX_ATTEMPTS=5
