generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY_MENTOR
  LAB_ASSISTANT
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  TEAM_ACCEPTANCE_PENDING
  MENTOR_APPROVAL_PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

enum ProjectMemberRole {
  LEADER
  MEMBER
}

enum ProjectMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum MentorRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EquipmentStatus {
  AVAILABLE
  PARTIALLY_AVAILABLE
  IN_USE
  UNAVAILABLE
  UNDER_MAINTENANCE
  DAMAGED
  OUT_OF_SERVICE
}

enum SlotStatus {
  OPEN
  BLOCKED
  CLOSED
}

enum BookingStatus {
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingCancellationSource {
  STUDENT
  LAB_ASSISTANT
  ADMIN
  SUPER_ADMIN
}

enum QuickVisitStatus {
  REQUESTED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AttendanceStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  googleSubject        String?                @unique @map("google_subject")
  email                String                 @unique
  name                 String
  avatarUrl            String?                @map("avatar_url")
  roles                UserRole[]             @default([STUDENT])
  profileComplete      Boolean                @default(false) @map("profile_complete")
  isActive             Boolean                @default(true) @map("is_active")
  tokenVersion         Int                    @default(0) @map("token_version")
  lastLoginAt          DateTime?              @map("last_login_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  deletedAt            DateTime?              @map("deleted_at")
  studentProfile       StudentProfile?
  sessions             Session[]
  provisionsCreated    UserProvisioning[]     @relation("ProvisionCreatedBy")
  provisionClaimed     UserProvisioning?      @relation("ProvisionClaimedBy")
  labsCreated          Lab[]                  @relation("LabCreatedBy")
  projectsCreated      Project[]              @relation("ProjectCreatedBy")
  projectMemberships   ProjectMember[]
  projectsMentored     Project[]              @relation("CurrentMentor")
  mentorRequests       MentorRequest[]        @relation("MentorFaculty")
  bookingsCreated      Booking[]              @relation("BookingCreatedBy")
  bookingsCancelled    Booking[]              @relation("BookingCancelledBy")
  bookingParticipants  BookingParticipant[]
  bookingStatusChanges BookingStatusHistory[] @relation("BookingStatusActor")
  quickVisits          QuickVisit[]
  visits               Visit[]                @relation("VisitUser")
  visitsCheckedIn      Visit[]                @relation("VisitCheckedInBy")
  visitsCheckedOut     Visit[]                @relation("VisitCheckedOutBy")
  eventsOrganized      Event[]                @relation("EventOrganizer")
  eventRegistrations   EventRegistration[]
  notifications        Notification[]
  uploads              Upload[]
  auditEvents          AuditLog[]             @relation("AuditActor")

  @@index([email])
  @@index([roles], type: Gin)
  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model UserProvisioning {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique
  roles       UserRole[]
  isActive    Boolean    @default(true) @map("is_active")
  createdById String?    @map("created_by_id") @db.Uuid
  claimedById String?    @unique @map("claimed_by_id") @db.Uuid
  claimedAt   DateTime?  @map("claimed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  createdBy   User?      @relation("ProvisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  claimedBy   User?      @relation("ProvisionClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([isActive, claimedAt])
  @@map("user_provisioning")
}

model Department {
  id         String           @id @default(uuid()) @db.Uuid
  code       String           @unique
  name       String           @unique
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  programmes Programme[]
  students   StudentProfile[]

  @@map("departments")
}

model Programme {
  id           String           @id @default(uuid()) @db.Uuid
  departmentId String           @map("department_id") @db.Uuid
  code         String
  name         String
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students     StudentProfile[]

  @@unique([departmentId, code])
  @@index([departmentId, isActive])
  @@map("programmes")
}

model AcademicYearOption {
  id        String   @id @default(uuid()) @db.Uuid
  value     Int      @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, value])
  @@map("academic_year_options")
}

model StudentProfile {
  userId       String     @id @map("user_id") @db.Uuid
  prn          String     @unique @db.VarChar(24)
  departmentId String     @map("department_id") @db.Uuid
  programmeId  String     @map("programme_id") @db.Uuid
  academicYear Int        @map("academic_year")
  division     String?
  phone        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  programme    Programme  @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@index([departmentId])
  @@index([programmeId, academicYear])
  @@map("student_profiles")
}

model Lab {
  id                           String               @id @default(uuid()) @db.Uuid
  name                         String               @unique
  code                         String               @unique
  description                  String?
  timeZone                     String               @default("Asia/Kolkata") @map("time_zone")
  slotDurationMinutes          Int                  @default(60) @map("slot_duration_minutes")
  bookingCapacity              Int                  @default(20) @map("booking_capacity")
  quickVisitCapacity           Int                  @default(10) @map("quick_visit_capacity")
  quickVisitsEnabled           Boolean              @default(true) @map("quick_visits_enabled")
  bookingHorizonDays           Int                  @default(14) @map("booking_horizon_days")
  cancellationWindowHours      Int                  @default(2) @map("cancellation_window_hours")
  maxFutureBookingsPerProject  Int?                 @map("max_future_bookings_per_project")
  /// Version 1 RFP invariant. Enforced by a database CHECK constraint and API validation.
  projectVerificationRequired  Boolean              @default(true) @map("project_verification_required")
  teamLeaderAttendanceRequired Boolean              @default(true) @map("team_leader_attendance_required")
  configurationVersion         Int                  @default(1) @map("configuration_version")
  isActive                     Boolean              @default(true) @map("is_active")
  createdById                  String?              @map("created_by_id") @db.Uuid
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")
  createdBy                    User?                @relation("LabCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  schedules                    LabSchedule[]
  dateExceptions               LabDateException[]
  slots                        LabSlot[]
  equipmentCategories          EquipmentCategory[]
  equipment                    Equipment[]
  consumableCategories         ConsumableCategory[]
  consumables                  Consumable[]
  projects                     Project[]
  bookings                     Booking[]
  quickVisits                  QuickVisit[]
  visits                       Visit[]
  events                       Event[]

  @@index([isActive])
  @@map("labs")
}

model LabSchedule {
  id             String  @id @default(uuid()) @db.Uuid
  labId          String  @map("lab_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week")
  opensAtMinute  Int     @map("opens_at_minute")
  closesAtMinute Int     @map("closes_at_minute")
  isOpen         Boolean @default(true) @map("is_open")
  lab            Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, dayOfWeek])
  @@map("lab_schedules")
}

model LabDateException {
  id             String   @id @default(uuid()) @db.Uuid
  labId          String   @map("lab_id") @db.Uuid
  localDate      DateTime @map("local_date") @db.Date
  isClosed       Boolean  @default(true) @map("is_closed")
  opensAtMinute  Int?     @map("opens_at_minute")
  closesAtMinute Int?     @map("closes_at_minute")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lab            Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId, localDate])
  @@index([labId, localDate, isClosed])
  @@map("lab_date_exceptions")
}

model LabSlot {
  id                 String       @id @default(uuid()) @db.Uuid
  labId              String       @map("lab_id") @db.Uuid
  localDate          DateTime     @map("local_date") @db.Date
  startsAt           DateTime     @map("starts_at")
  endsAt             DateTime     @map("ends_at")
  bookingCapacity    Int          @map("booking_capacity")
  quickVisitCapacity Int          @map("quick_visit_capacity")
  policyVersion      Int          @default(1) @map("policy_version")
  status             SlotStatus   @default(OPEN)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  lab                Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  quickVisits        QuickVisit[]

  @@unique([labId, startsAt, endsAt])
  @@index([labId, localDate, status])
  @@index([labId, status, startsAt])
  @@map("lab_slots")
}

model EquipmentCategory {
  id        String      @id @default(uuid()) @db.Uuid
  labId     String      @map("lab_id") @db.Uuid
  name      String
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  lab       Lab         @relation(fields: [labId], references: [id], onDelete: Cascade)
  equipment Equipment[]

  @@unique([labId, name])
  @@index([labId, isActive])
  @@map("equipment_categories")
}

model Equipment {
  id                  String                        @id @default(uuid()) @db.Uuid
  labId               String                        @map("lab_id") @db.Uuid
  categoryId          String                        @map("category_id") @db.Uuid
  name                String
  description         String
  status              EquipmentStatus               @default(AVAILABLE)
  imageUrl            String?                       @map("image_url")
  totalQuantity       Int                           @default(1) @map("total_quantity")
  availableQuantity   Int                           @default(1) @map("available_quantity")
  specs               String[]                      @default([])
  visible             Boolean                       @default(true)
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  deletedAt           DateTime?                     @map("deleted_at")
  lab                 Lab                           @relation(fields: [labId], references: [id], onDelete: Restrict)
  category            EquipmentCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projectRequirements ProjectEquipmentRequirement[]

  @@unique([labId, name])
  @@index([labId, categoryId, status])
  @@index([visible, deletedAt])
  @@map("equipment")
}

model ConsumableCategory {
  id          String       @id @default(uuid()) @db.Uuid
  labId       String       @map("lab_id") @db.Uuid
  name        String
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  lab         Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  consumables Consumable[]

  @@unique([labId, name])
  @@map("consumable_categories")
}

model Consumable {
  id                  String                         @id @default(uuid()) @db.Uuid
  labId               String                         @map("lab_id") @db.Uuid
  categoryId          String                         @map("category_id") @db.Uuid
  name                String
  unit                String
  description         String?
  isActive            Boolean                        @default(true) @map("is_active")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  lab                 Lab                            @relation(fields: [labId], references: [id], onDelete: Restrict)
  category            ConsumableCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projectRequirements ProjectConsumableRequirement[]

  @@unique([labId, name])
  @@index([labId, categoryId, isActive])
  @@map("consumables")
}

model Project {
  id                     String                         @id @default(uuid()) @db.Uuid
  labId                  String                         @map("lab_id") @db.Uuid
  creatorId              String                         @map("creator_id") @db.Uuid
  currentMentorId        String?                        @map("current_mentor_id") @db.Uuid
  title                  String
  description            String
  domain                 String?
  status                 ProjectStatus                  @default(DRAFT)
  tags                   String[]                       @default([])
  rejectionReason        String?                        @map("rejection_reason")
  idempotencyKey         String?                        @map("idempotency_key") @db.Uuid
  submittedAt            DateTime?                      @map("submitted_at")
  createdAt              DateTime                       @default(now()) @map("created_at")
  updatedAt              DateTime                       @updatedAt @map("updated_at")
  deletedAt              DateTime?                      @map("deleted_at")
  lab                    Lab                            @relation(fields: [labId], references: [id], onDelete: Restrict)
  creator                User                           @relation("ProjectCreatedBy", fields: [creatorId], references: [id], onDelete: Restrict)
  currentMentor          User?                          @relation("CurrentMentor", fields: [currentMentorId], references: [id], onDelete: SetNull)
  members                ProjectMember[]
  mentorRequests         MentorRequest[]
  equipmentRequirements  ProjectEquipmentRequirement[]
  consumableRequirements ProjectConsumableRequirement[]
  bookings               Booking[]

  @@unique([creatorId, idempotencyKey])
  @@index([creatorId, status])
  @@index([currentMentorId, status])
  @@index([labId, status, createdAt])
  @@map("projects")
}

model ProjectMember {
  id                      String              @id @default(uuid()) @db.Uuid
  projectId               String              @map("project_id") @db.Uuid
  userId                  String?             @map("user_id") @db.Uuid
  email                   String
  role                    ProjectMemberRole   @default(MEMBER)
  status                  ProjectMemberStatus @default(PENDING)
  invitationTokenHash     String?             @unique @map("invitation_token_hash")
  invitationExpiresAt     DateTime?           @map("invitation_expires_at")
  invitationEmailStatus   DeliveryStatus?     @map("invitation_email_status")
  invitationEmailAttempts Int                 @default(0) @map("invitation_email_attempts")
  invitationEmailSentAt   DateTime?           @map("invitation_email_sent_at")
  acceptedAt              DateTime?           @map("accepted_at")
  respondedAt             DateTime?           @map("responded_at")
  removedAt               DateTime?           @map("removed_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  project                 Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([email, status])
  @@index([invitationEmailStatus, createdAt])
  @@map("project_members")
}

model MentorRequest {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @map("project_id") @db.Uuid
  facultyId   String              @map("faculty_id") @db.Uuid
  status      MentorRequestStatus @default(PENDING)
  reason      String?
  requestedAt DateTime            @default(now()) @map("requested_at")
  respondedAt DateTime?           @map("responded_at")
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  faculty     User                @relation("MentorFaculty", fields: [facultyId], references: [id], onDelete: Restrict)

  @@index([facultyId, status, requestedAt])
  @@index([projectId, status])
  @@map("mentor_requests")
}

model ProjectEquipmentRequirement {
  projectId   String    @map("project_id") @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  quantity    Int       @default(1)
  notes       String?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([projectId, equipmentId])
  @@map("project_equipment_requirements")
}

model ProjectConsumableRequirement {
  projectId        String     @map("project_id") @db.Uuid
  consumableId     String     @map("consumable_id") @db.Uuid
  expectedQuantity Decimal?   @map("expected_quantity") @db.Decimal(12, 3)
  notes            String?
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consumable       Consumable @relation(fields: [consumableId], references: [id], onDelete: Restrict)

  @@id([projectId, consumableId])
  @@map("project_consumable_requirements")
}

model Booking {
  id                              String                     @id @default(uuid()) @db.Uuid
  labId                           String                     @map("lab_id") @db.Uuid
  labSlotId                       String                     @map("lab_slot_id") @db.Uuid
  projectId                       String                     @map("project_id") @db.Uuid
  createdById                     String                     @map("created_by_id") @db.Uuid
  cancelledById                   String?                    @map("cancelled_by_id") @db.Uuid
  idempotencyKey                  String                     @map("idempotency_key") @db.Uuid
  creationRequestFingerprint      String                     @map("creation_request_fingerprint") @db.Char(64)
  cancellationIdempotencyKey      String?                    @map("cancellation_idempotency_key") @db.Uuid
  cancellationRequestFingerprint  String?                    @map("cancellation_request_fingerprint") @db.Char(64)
  attendeeCount                   Int                        @map("attendee_count")
  status                          BookingStatus              @default(CONFIRMED)
  notes                           String?
  labNameSnapshot                 String                     @map("lab_name_snapshot")
  projectTitleSnapshot            String                     @map("project_title_snapshot")
  slotStartsAtSnapshot            DateTime                   @map("slot_starts_at_snapshot")
  slotEndsAtSnapshot              DateTime                   @map("slot_ends_at_snapshot")
  timeZoneSnapshot                String                     @map("time_zone_snapshot")
  cancellationWindowHoursSnapshot Int                        @map("cancellation_window_hours_snapshot")
  cancellationSource              BookingCancellationSource? @map("cancellation_source")
  cancelledByNameSnapshot         String?                    @map("cancelled_by_name_snapshot")
  cancelledByRoleSnapshot         UserRole?                  @map("cancelled_by_role_snapshot")
  cancelledAt                     DateTime?                  @map("cancelled_at")
  cancellationReason              String?                    @map("cancellation_reason")
  createdAt                       DateTime                   @default(now()) @map("created_at")
  updatedAt                       DateTime                   @updatedAt @map("updated_at")
  lab                             Lab                        @relation(fields: [labId], references: [id], onDelete: Restrict)
  labSlot                         LabSlot                    @relation(fields: [labSlotId], references: [id], onDelete: Restrict)
  project                         Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy                       User                       @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy                     User?                      @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  participants                    BookingParticipant[]
  statusHistory                   BookingStatusHistory[]
  visits                          Visit[]

  @@unique([createdById, idempotencyKey])
  @@unique([cancelledById, cancellationIdempotencyKey])
  @@index([labSlotId, status])
  @@index([projectId, createdAt])
  @@index([createdById, status, createdAt])
  @@index([createdById, status, slotStartsAtSnapshot, id])
  @@index([projectId, status, slotStartsAtSnapshot, id])
  @@index([labId, status, slotStartsAtSnapshot, id])
  @@index([slotStartsAtSnapshot, id])
  @@index([status, slotStartsAtSnapshot, id])
  @@index([slotEndsAtSnapshot, status])
  @@map("bookings")
}

model BookingParticipant {
  bookingId           String            @map("booking_id") @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  attendanceStatus    AttendanceStatus  @default(EXPECTED) @map("attendance_status")
  nameSnapshot        String            @map("name_snapshot")
  emailSnapshot       String            @map("email_snapshot")
  prnSnapshot         String?           @map("prn_snapshot") @db.VarChar(24)
  projectRoleSnapshot ProjectMemberRole @map("project_role_snapshot")
  booking             Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([bookingId, userId])
  @@index([userId, attendanceStatus])
  @@index([userId, bookingId])
  @@map("booking_participants")
}

model BookingStatusHistory {
  id                String         @id @default(uuid()) @db.Uuid
  bookingId         String         @map("booking_id") @db.Uuid
  fromStatus        BookingStatus? @map("from_status")
  toStatus          BookingStatus  @map("to_status")
  actorUserId       String?        @map("actor_user_id") @db.Uuid
  actorNameSnapshot String         @map("actor_name_snapshot")
  actorRoleSnapshot UserRole       @map("actor_role_snapshot")
  reason            String?
  notes             String?
  idempotencyKey    String?        @map("idempotency_key") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor             User?          @relation("BookingStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([bookingId, idempotencyKey])
  @@index([bookingId, createdAt, id])
  @@index([actorUserId, createdAt])
  @@map("booking_status_history")
}

model QuickVisit {
  id             String           @id @default(uuid()) @db.Uuid
  labId          String           @map("lab_id") @db.Uuid
  labSlotId      String           @map("lab_slot_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key") @db.Uuid
  purpose        String
  status         QuickVisitStatus @default(REQUESTED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  lab            Lab              @relation(fields: [labId], references: [id], onDelete: Restrict)
  labSlot        LabSlot          @relation(fields: [labSlotId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  visit          Visit?

  @@unique([userId, idempotencyKey])
  @@index([labSlotId, status])
  @@index([userId, createdAt])
  @@map("quick_visits")
}

model Visit {
  id             String           @id @default(uuid()) @db.Uuid
  labId          String           @map("lab_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  bookingId      String?          @map("booking_id") @db.Uuid
  quickVisitId   String?          @unique @map("quick_visit_id") @db.Uuid
  status         AttendanceStatus @default(CHECKED_IN)
  checkedInAt    DateTime         @default(now()) @map("checked_in_at")
  checkedOutAt   DateTime?        @map("checked_out_at")
  checkedInById  String           @map("checked_in_by_id") @db.Uuid
  checkedOutById String?          @map("checked_out_by_id") @db.Uuid
  lab            Lab              @relation(fields: [labId], references: [id], onDelete: Restrict)
  user           User             @relation("VisitUser", fields: [userId], references: [id], onDelete: Restrict)
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quickVisit     QuickVisit?      @relation(fields: [quickVisitId], references: [id], onDelete: Restrict)
  checkedInBy    User             @relation("VisitCheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  checkedOutBy   User?            @relation("VisitCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)

  @@unique([bookingId, userId])
  @@index([labId, status, checkedInAt])
  @@index([userId, checkedInAt])
  @@map("visits")
}

model Event {
  id            String              @id @default(uuid()) @db.Uuid
  labId         String              @map("lab_id") @db.Uuid
  title         String
  description   String
  organizerId   String              @map("organizer_id") @db.Uuid
  location      String
  startTime     DateTime            @map("start_time")
  endTime       DateTime            @map("end_time")
  capacity      Int
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")
  lab           Lab                 @relation(fields: [labId], references: [id], onDelete: Restrict)
  organizer     User                @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([labId, startTime])
  @@index([organizerId])
  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  href       String?
  isRead     Boolean                @default(false) @map("is_read")
  readAt     DateTime?              @map("read_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  deletedAt  DateTime?              @map("deleted_at")
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  providerId     String?             @map("provider_id")
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model Upload {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  url       String
  publicId  String    @map("public_id")
  mimeType  String    @map("mime_type")
  bytes     Int
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("uploads")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
